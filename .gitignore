__pycache__/
*.pyc
*.pyo
.DS_Store

# Wyniki biegow Imperium (generowane)
imperium/**/wykres_biegu.png
imperium/**/raport_biegu_*.md
imperium/**/raport_biegu_*.json
imperium/**/DZIENNIK_WYNIKOW.md
imperium/**/dane/*.csv

# Dane historyczne CSV — trzymane lokalnie / zewnętrznie (nie w repo)
dane/minutowe/*.csv
dane/*5m*.csv
dane/*15m*.csv
dane/*1m*.csv
dane/*4h*.csv
# Konwertowane pliki robocze (generowane przez backtest runner)
dane/*_imp.csv
# Cache sentymentu (funding/OI/L-S) — pobierany lokalnie z Binance public (backfill_sentyment.py)
dane/sentyment/*.csv
# Dzienne (~320 KB) i godzinowe (~8 MB) — małe, śledzone w repo (NIE ignorowane)
raporty/

# Stan uczenia cross-session (generowany w runtime — nie wersjonowany)
logs/
narzedzia/rag/baza_wiedzy.db

# Lokalne artefakty A/B (generowane przez backtest_ab_* — nie wersjonowane, wynik w LOG_ZMIAN)
ab_mtf_metryki.json
ab_mtf_wynik.txt
ab_mtf_rezimy_metryki.json
ab_mtf_rezimy_wynik.txt
# Marker przetworzonych sesji auto-lekcji (stan runtime, per-maszyna)
bibliotheca_ulpia/dane/.auto_lekcja_przetworzone.txt
